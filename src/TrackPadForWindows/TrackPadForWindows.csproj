<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 API'leriyle derlenir, Windows 10 1809 (17763) ve sonrasında çalışır. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TrackPadForWindows</AssemblyName>
    <RootNamespace>TrackPadForWindows</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>TrackPad For Windows</Product>
    <AssemblyTitle>TrackPad For Windows</AssemblyTitle>
    <Description>Touchpad gestures and radial menu for Windows Precision Touchpads</Description>
    <Company>TrackPad For Windows</Company>
    <Copyright>Copyright © 2026 Anex</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- UseWindowsForms yerine doğrudan referans: Windows Desktop SDK'sı olmayan ortamlarda da derlenir. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="TrackPadForWindows.app.ico" />
  </ItemGroup>

</Project>
